{
  "description": "ShopGlobal Smart Routing test set - bilingual (EN/ES) prompts labelled with the model tier the gateway SHOULD pick. Order/product context is built from data/orders.json and data/products.json (adapted from the AWS agentic-AI evaluation workshop).",
  "version": "1.1",
  "labels": {
    "cheap": "simple order-status lookups (eval/prices.json tiers.cheap)",
    "premium": "reasoning, comparison, policy, multi-intent (tiers.premium)",
    "null": "must be blocked by prompt guard"
  },
  "tier_note": "Cases are labelled with a TIER, not a model name, so swapping models (e.g. after a provider retires one) needs no relabelling.",
  "must_have_facts_syntax": "Each entry must appear in the answer (case-insensitive). 'a|b' means either alternative is accepted.",
  "slices": [
    "borderline",
    "complex",
    "guardrail",
    "order_status"
  ],
  "test_cases": [
    {
      "id": "RT-EN-001",
      "pair_id": "P001",
      "lang": "en",
      "slice": "order_status",
      "category": "where_is_order",
      "difficulty": "easy",
      "channel": "chat",
      "input": "Where is my order ORD-2024-10002?",
      "context_refs": {
        "orders": [
          "ORD-2024-10002"
        ]
      },
      "expected_behavior": "route",
      "expected_tier": "cheap",
      "must_have_facts": [
        "UPS",
        "1Z999AA10123456784"
      ],
      "notes": "Plain lookup: carrier + tracking."
    },
