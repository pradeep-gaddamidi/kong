# --- Konnect data plane (docker-compose) ---
KONNECT_CP_ENDPOINT=xxxxxxxx.us.cp0.konghq.com
KONNECT_TELEMETRY_ENDPOINT=xxxxxxxx.us.tp0.konghq.com
KONNECT_DP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
KONNECT_DP_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- decK (substituted into kong/kong.yaml) ---
KONNECT_TOKEN=kpat_xxx
DECK_OPENAI_API_KEY=sk-proj-xxx   # project key with a monthly budget set in OpenAI settings
DECK_BOT_API_KEY=change-me-bot-key
DECK_EVAL_API_KEY=change-me-eval-key

# --- eval harness ---
KONG_PROXY_URL=http://localhost:8000
KONG_API_KEY=change-me-eval-key
