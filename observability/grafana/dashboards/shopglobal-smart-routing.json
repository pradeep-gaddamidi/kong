{
  "uid": "shopglobal-smart-routing",
  "title": "ShopGlobal Smart Routing",
  "tags": [
    "kong",
    "ai-gateway",
    "shopglobal"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Share answered by cheap model",
      "description": "Fraction of AI requests served by gpt-6-luna. Should roughly match the share of simple order-status questions.",
      "datasource": {
        "type": "prometheus",
        "uid": "kong-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kong-prom"
          },
          "expr": "sum(increase(kong_ai_llm_requests_total{ai_model=\"gpt-6-luna\"}[$__range])) / sum(increase(kong_ai_llm_requests_total[$__range]))",
          "legendFormat": "cheap share",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AI spend in range",
      "description": "Kong cost metric is in micro-dollars (kong.yaml prices x 1e6), divided back to dollars here.",
      "datasource": {
        "type": "prometheus",
        "uid": "kong-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kong-prom"
          },
          "expr": "sum(increase(kong_ai_llm_cost_total[$__range])) / 1e6",
          "legendFormat": "USD",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "AI requests in range",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kong-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kong-prom"
          },
          "expr": "sum(increase(kong_ai_llm_requests_total[$__range]))",
          "legendFormat": "requests",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Blocked before any model call ($0)",
      "description": "HTTP 400 = prompt guards blocked injection / off-topic abuse before the model was called.",
      "datasource": {
        "type": "prometheus",
        "uid": "kong-prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kong-prom"
          },
          "expr": "sum(increase(kong_http_requests_total{code=\"400\"}[$__range]))",
          "legendFormat": "400s",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Spend per model ($/hour)",
      "description": "Premium model carries most of the dollars even with fewer requests: why routing matters.",
      "datasource": {
        "type": "prometheus",
        "uid": "kong-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kong-prom"
          },
          "expr": "sum by (ai_model) (rate(kong_ai_llm_cost_total[5m])) * 3600 / 1e6",
          "legendFormat": "{{ai_model}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per model (per minute)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "kong-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
