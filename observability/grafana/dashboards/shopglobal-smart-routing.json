      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kong-prom"
          },
          "expr": "sum by (ai_model) (rate(kong_ai_llm_requests_total[5m])) * 60",
          "legendFormat": "{{ai_model}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
